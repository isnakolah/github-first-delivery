#!/bin/sh
set -eu
if [ "${GFD_BOOTSTRAP_ADMIN:-}" = "1" ]; then
  printf '%s\n' 'gfd bootstrap administration mode: write allowed'
  exit 0
fi
if ! command -v gfd >/dev/null 2>&1; then
	printf '%s\n' 'gfd missing; edit denied outside documented bootstrap administration' >&2
	exit 2
fi
if [ -z "${GFD_LEASE_ISSUE:-}" ] || [ -z "${GFD_LEASE_HOLDER:-}" ]; then
  printf '%s\n' 'gfd active lease context missing; edit denied' >&2
  exit 2
fi
gfd context --json >/dev/null
